# VigilAI Backend Environment Configuration
# Copy this file to .env and update with your actual database credentials

# FastAPI Server settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Secure Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vigilai_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# JWT Authentication Security Settings
# Generate a strong random key in production (e.g., using: openssl rand -hex 32)
SECRET_KEY=45fbe2f168cd0eb92df2bb83b0f6976f68c37d6e5df5a3c9b13da87cf97c0fdb
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Detection Model Settings (YOLOv8 & MediaPipe Pose)
YOLO_MODEL=yolov8n.pt
DETECTION_CONFIDENCE=0.5

# Face Recognition Settings (DeepFace FaceNet)
FACE_RECOGNITION_THRESHOLD=0.6
FACE_RECOGNITION_MODEL=FaceNet

# Video Stream & Camera Performance settings
MAX_FRAME_WIDTH=1280
MAX_FRAME_HEIGHT=720
FRAME_RATE=30

# Logging Configurations
LOG_LEVEL=INFO

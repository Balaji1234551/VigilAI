rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default rule: Deny all access to any document not specifically matched below
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow authenticated users to read and write their OWN user profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Example: Allow any authenticated user to read all public cameras, but only admins/owners can write
    match /cameras/{cameraId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
    
    // Example: Allow users to read and write their own alerts
    match /alerts/{alertId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
